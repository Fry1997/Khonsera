# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App config ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Integrations (all optional; stubs run when missing) ---
# Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Maps / routing
GOOGLE_MAPS_API_KEY=
MAPBOX_TOKEN=

# Rail timetable / live data
RAIL_API_BASE_URL=
RAIL_API_KEY=

# Rail booking partner (Trainline or similar)
RAIL_BOOKING_AFFILIATE_ID=
RAIL_BOOKING_DEEPLINK_BASE=

# Notifications
RESEND_API_KEY=
