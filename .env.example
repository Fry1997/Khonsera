# --- Supabase (required) ---
# Live project: journies (attbfwemjoslugvtfbrt) in eu-west-1
# Get current values via the Supabase dashboard or
#   mcp__Supabase__get_project_url + mcp__Supabase__get_publishable_keys
NEXT_PUBLIC_SUPABASE_URL=https://attbfwemjoslugvtfbrt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key only needed for integration tests and admin scripts.
# NEVER expose to the browser. Pull from Supabase dashboard > Project Settings > API.
SUPABASE_SERVICE_ROLE_KEY=

# --- App config ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Integrations (all optional; stubs run when missing) ---
# Google Calendar — see Google Cloud Console > APIs & Services > Credentials.
# Create an OAuth 2.0 Client (Web application). Authorised redirect URIs:
#   https://<your-domain>/api/auth/google/callback
#   http://localhost:3000/api/auth/google/callback
# Enable the "Google Calendar API" in the same project. Scopes used:
#   calendar.readonly + calendar.events (set at runtime, not in console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: explicit override if your callback host differs from NEXT_PUBLIC_APP_URL
# GOOGLE_OAUTH_REDIRECT_URL=

# Maps / routing
GOOGLE_MAPS_API_KEY=
MAPBOX_TOKEN=

# Rail timetable / live data
RAIL_API_BASE_URL=
RAIL_API_KEY=

# Rail booking partner (Trainline or similar)
RAIL_BOOKING_AFFILIATE_ID=
RAIL_BOOKING_DEEPLINK_BASE=

# Notifications
RESEND_API_KEY=
