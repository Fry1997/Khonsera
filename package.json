    "@vercel/speed-insights": "^2.0.0",
    "bwip-js": "^4.10.1",
    "chrono-node": "^2.9.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.451.0",
    "maplibre-gl": "^5.24.0",
    "next": "^15.5.18",
    "pmtiles": "^4.4.1",
    "posthog-js": "^1.433.10",
    "protomaps-themes-base": "^4.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.4",
